{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "@safar-shared/*": ["../src/lib/*"],
      "@safar-db": ["../src/integrations/supabase/types.ts"]
    }
  },
  "include": ["src", "vite.config.ts", "capacitor.config.ts"]
}
