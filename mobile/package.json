{
  "name": "safar-erp-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "prestart": "node scripts/prepare-environment.mjs",
    "start": "ng serve",
    "prebuild": "node scripts/prepare-environment.mjs",
    "build": "ng build",
    "precheck": "node scripts/prepare-environment.mjs",
    "check": "tsc --noEmit -p tsconfig.app.json",
    "native:sync": "npm run build && cap sync",
    "android:debug": "npm run native:sync && cd android && ./gradlew assembleDebug",
    "ios:open": "npm run native:sync && cap open ios"
  },
  "dependencies": {
    "@angular/common": "21.2.26",
    "@angular/compiler": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@supabase/supabase-js": "2.95.3",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.30",
    "@angular/cli": "21.2.30",
    "@angular/compiler-cli": "21.2.26",
    "@capacitor/cli": "8.6.2",
    "typescript": "5.9.3"
  }
}
