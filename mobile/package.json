{
  "name": "safar-erp-mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "prestart": "node scripts/prepare-environment.mjs",
    "start": "vite",
    "prebuild": "node scripts/prepare-environment.mjs",
    "build": "vite build",
    "precheck": "node scripts/prepare-environment.mjs",
    "check": "tsc --noEmit",
    "native:sync": "npm run build && cap sync",
    "android:debug": "npm run native:sync && cd android && ./gradlew assembleDebug",
    "ios:open": "npm run native:sync && cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/push-notifications": "8.1.3",
    "@radix-ui/react-dialog": "1.3.1",
    "@supabase/supabase-js": "2.95.3",
    "@tanstack/react-query": "5.108.0",
    "lucide-react": "0.462.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react-swc": "3.11.0",
    "typescript": "5.9.3",
    "vite": "5.4.21"
  }
}
