          "properties": {
            "query": {
              "type": "string",
              "description": "Name, email, or phone fragment to search for."
            },
            "limit": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991,
              "description": "Maximum number of customers to return (default 20)."
